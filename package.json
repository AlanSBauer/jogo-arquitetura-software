{
  "name": "blood-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "server": "node server/index.js --server-only",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:architecture && npm run test:rules && npm run test:ai && npm run test:progress && npm run test:multiplayer",
    "check": "npm run lint && npm run test && npm run build",
    "test:ai": "node src/game/application/ai/verifyAI.mjs",
    "test:rules": "node src/game/domain/rules/verifyRules.mjs",
    "test:progress": "node src/game/application/progress/verifyProgress.mjs",
    "test:architecture": "node src/game/application/verifyArchitecture.mjs",
    "test:multiplayer": "node server/verifyMultiplayer.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "vite": "^6.4.3"
  }
}
